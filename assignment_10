
#include <iostream>
using namespace std;

int main() {
    int a, b;

    cout << "Enter two numbers: ";
    cin >> a >> b;

    try {
        if (b == 0) {
            throw b;
        }

        cout << "Division = " << a / b << endl;
    }

    catch (int x) {
        cout << "Exception caught!" << endl;
        cout << "Error: Division by zero is not possible." << endl;
    }

    cout << "Program continues after exception handling." << endl;

    return 0;
}
