
#include <iostream>
using namespace std;

class Complex {
    float real, imag;

public:
    // Function to read complex number
    void read() {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    // Function to display complex number
    void display() {
        cout << real;

        if (imag >= 0)
            cout << " + " << imag << "i";
        else
            cout << " - " << -imag << "i";

        cout << endl;
    }

    // Overloading + operator
    Complex operator+(Complex c) {
        Complex temp;
        temp.real = real + c.real;
        temp.imag = imag + c.imag;
        return temp;
    }

    // Overloading - operator
    Complex operator-(Complex c) {
        Complex temp;
        temp.real = real - c.real;
        temp.imag = imag - c.imag;
        return temp;
    }

    // Overloading * operator
    Complex operator*(Complex c) {
        Complex temp;
        temp.real = real * c.real - imag * c.imag;
        temp.imag = real * c.imag + imag * c.real;
        return temp;
    }

    // Overloading / operator
    Complex operator/(Complex c) {
        Complex temp;

        float denominator = c.real * c.real +
                            c.imag * c.imag;

        temp.real = (real * c.real +
                     imag * c.imag) / denominator;

        temp.imag = (imag * c.real -
                     real * c.imag) / denominator;

        return temp;
    }

    // Check division by zero
    bool isZero() {
        return real == 0 && imag == 0;
    }
};

int main() {
    Complex c1, c2, result;

    cout << "Enter first complex number:" << endl;
    c1.read();

    cout << "\nEnter second complex number:" << endl;
    c2.read();

    cout << "\nFirst Complex Number: ";
    c1.display();

    cout << "Second Complex Number: ";
    c2.display();

    // Addition
    result = c1 + c2;
    cout << "\nAddition: ";
    result.display();

    // Subtraction
    result = c1 - c2;
    cout << "Subtraction: ";
    result.display();

    // Multiplication
    result = c1 * c2;
    cout << "Multiplication: ";
    result.display();

    // Division
    if (c2.isZero()) {
        cout << "Division by zero is not possible!" << endl;
    }
    else {
        result = c1 / c2;
        cout << "Division: ";
        result.display();
    }

    return 0;
}
